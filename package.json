{
  "name": "dsh-media-skin",
  "version": "0.6.1",
  "description": "DSH 本地媒体皮肤：整窗一张图，或分栏让内容区与左侧栏各自配图；每张图都能拖动、滚轮缩放手动裁切（所见即所得），并且各自调节模糊、不透明度、亮度、饱和度、对比度；模糊用 backdrop-filter 实现，拖模糊不会放大取景。点素材卡切换调节对象，滑块只有一组，分栏时一键把整组调色复制到另一层。磨砂玻璃面板 + 蓝鲸厨娘头像圆钮；素材只走上传。",
  "license": "MIT",
  "author": "svd748xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svd748xyz/dsh-media-skin.git"
  },
  "homepage": "https://github.com/svd748xyz/dsh-media-skin#readme",
  "bugs": {
    "url": "https://github.com/svd748xyz/dsh-media-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "background",
    "wallpaper",
    "media",
    "video",
    "skin",
    "theme"
  ],
  "type": "module",
  "scripts": {
    "test": "node tests/smoke.mjs",
    "prepublishOnly": "node tests/smoke.mjs",
    "verify:home": "node scripts/make-verify-home.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/screenshots",
    "docs/preview.svg",
    "assets",
    "icon.svg",
    "README.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
